# ============================================================================
# インボイス作成 (Invoice Sakusei) — environment template
# Copy to .env and fill in real values. NEVER commit the resulting .env.
#   cp .env.example .env
#
# DEPLOYING TO A PLATFORM (Vercel, Fly, Railway, …)
# ------------------------------------------------
# Set these in the platform's own environment settings, not in a committed
# file. Every variable marked "required" below must be present for the RUNTIME
# environment, or the server refuses to start and says which one is missing.
#
# The BUILD does not need any of them: env validation runs on first use, so
# `next build` succeeds without production secrets. If a build ever fails with
# "Invalid environment configuration", something has started reading the
# environment at module scope again — see src/lib/env.ts.
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE_URL (required, server-only)
# PostgreSQL connection string consumed by Prisma. This value must never be
# exposed to the browser: do not prefix it with NEXT_PUBLIC_ and do not import
# it from a "use client" module.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---------------------------------------------------------------------------
# AUTH_SECRET (required, server-only)
# HMAC key used to sign session tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-32-char-minimum-random-string"

# ---------------------------------------------------------------------------
# NODE_ENV (optional) — development | test | production
# ---------------------------------------------------------------------------
NODE_ENV="development"

# ---------------------------------------------------------------------------
# APP_URL (optional) — public origin of the deployment.
#
# SECURITY-RELEVANT. Whether this starts with "https://" is the single signal
# that decides three things at once (src/lib/transport.ts):
#
#   - Secure attribute + __Secure-/__Host- prefixes on session cookies
#   - Strict-Transport-Security
#   - upgrade-insecure-requests in the Content-Security-Policy
#
# It is also the origin used to build the sign-in redirect, so it must be the
# origin a browser actually reaches — including a non-default port if the public
# URL has one (https://invoice.example.com:8443). Behind a TLS-terminating proxy
# the app cannot infer this: its own view is the internal http://localhost:3000.
#
# Set it to the real public https:// origin in production. Leaving it as an
# http:// value on a TLS deployment silently downgrades all three.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS (optional)
# Comma-separated list of extra origins accepted for Server Actions.
#
# Next.js rejects a Server Action whose Origin header does not match the Host —
# this is what makes actions CSRF-safe by default. Behind a proxy that rewrites
# Host, list the real public origins here or legitimate submissions are refused.
#   ALLOWED_ORIGINS="invoice.example.com,www.invoice.example.com"
# ---------------------------------------------------------------------------
# ALLOWED_ORIGINS=""

# ---------------------------------------------------------------------------
# PDF_CHROME_PATH (optional, server-only)
# Path to a Chrome/Chromium binary used to render invoice PDFs. Leave unset to
# use the build that ships with puppeteer. Set it in container images that
# install their own Chrome, e.g.:
#   PDF_CHROME_PATH="/usr/bin/chromium"
#
# The rendering host also needs a Japanese font installed (for example
# fonts-ipafont-gothic or fonts-noto-cjk) or the PDF will show blank boxes
# instead of kanji.
# ---------------------------------------------------------------------------
# PDF_CHROME_PATH=

# ---------------------------------------------------------------------------
# Stripe (optional, all server-only)
#
# Leave these unset to run without payments: the application works, the upgrade
# page explains that checkout is unavailable, and every account stays on the
# free plan.
#
# These are secrets. Never prefix them with NEXT_PUBLIC_, and never reference
# them from a "use client" module.
# ---------------------------------------------------------------------------

# Secret API key from the Stripe dashboard (Developers -> API keys).
STRIPE_SECRET_KEY="sk_test_..."

# Signing secret for the webhook endpoint (Developers -> Webhooks -> your
# endpoint -> Signing secret). Without it the webhook route returns 503 and
# refuses every event, because an unverifiable event must never be trusted.
#   Local development:
#     stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."

# Price ids for the two purchase shapes. At least one must be set for checkout
# to be offered.
STRIPE_PRICE_ID_MONTHLY="price_..."
STRIPE_PRICE_ID_LIFETIME="price_..."
