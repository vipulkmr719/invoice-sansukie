# ============================================================================
# インボイス作成 (Invoice Sakusei) — environment template
# Copy to .env and fill in real values. NEVER commit the resulting .env.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# DATABASE_URL (required, server-only)
# PostgreSQL connection string consumed by Prisma. This value must never be
# exposed to the browser: do not prefix it with NEXT_PUBLIC_ and do not import
# it from a "use client" module.
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ---------------------------------------------------------------------------
# AUTH_SECRET (required, server-only)
# HMAC key used to sign session tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-a-32-char-minimum-random-string"

# ---------------------------------------------------------------------------
# NODE_ENV (optional) — development | test | production
# ---------------------------------------------------------------------------
NODE_ENV="development"

# ---------------------------------------------------------------------------
# APP_URL (optional) — public origin of the deployment.
# ---------------------------------------------------------------------------
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# PDF_CHROME_PATH (optional, server-only)
# Path to a Chrome/Chromium binary used to render invoice PDFs. Leave unset to
# use the build that ships with puppeteer. Set it in container images that
# install their own Chrome, e.g.:
#   PDF_CHROME_PATH="/usr/bin/chromium"
#
# The rendering host also needs a Japanese font installed (for example
# fonts-ipafont-gothic or fonts-noto-cjk) or the PDF will show blank boxes
# instead of kanji.
# ---------------------------------------------------------------------------
# PDF_CHROME_PATH=
