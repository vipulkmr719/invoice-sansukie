// ============================================================================
//  インボイス作成 (Invoice Sakusei) — データベーススキーマ
//  Money is stored as integer yen (tax-exclusive where noted) so that no
//  floating point rounding can ever reach the database. Per-unit values that
//  legitimately carry fractions (quantity, unit price) use Decimal.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection string lives in prisma.config.ts (CLI) and in the
  // driver adapter (runtime). It is never inlined into the schema.
}

/// アカウント
model User {
  id String @id @default(cuid())

  email String @unique

  /// Nullable so a magic-link / OAuth identity can exist without a password.
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company?
  clients  Client[]
  invoices Invoice[]
  billing  Billing?

  @@map("users")
}

/// 自社情報 (invoice issuer). One per user.
model Company {
  id     String @id @default(cuid())
  userId String @unique

  name    String
  address String
  phone   String
  email   String

  /// 適格請求書発行事業者登録番号 — "T" + 13 digits.
  registrationNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companies")
}

/// 取引先 (billing counterparty)
model Client {
  id     String @id @default(cuid())
  userId String

  /// 担当者名 / 宛名 — required.
  name String

  /// 会社名 — optional: a counterparty may be an individual.
  companyName String?
  address     String?
  email       String?
  phone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  /// Tenant-scoped key. Invoice references (id, userId) rather than id alone,
  /// so the database itself refuses to link an invoice to another user's
  /// client — cross-tenant linkage is impossible, not merely checked.
  @@unique([id, userId])
  @@index([userId])
  @@index([userId, createdAt])
  @@map("clients")
}

/// 請求書
model Invoice {
  id       String @id @default(cuid())
  userId   String
  clientId String

  /// Unique per user, e.g. INV-2026-0001.
  invoiceNumber String

  issueDate DateTime @db.Date
  dueDate   DateTime @db.Date

  /// All amounts are integer yen. subtotal is tax-exclusive.
  subtotal Int
  /// 8% 軽減税率分の消費税額
  tax8 Int
  /// 10% 標準税率分の消費税額
  tax10 Int
  /// subtotal + tax8 + tax10
  total Int

  notes String?

  // --------------------------------------------------------------------------
  // Snapshot of the parties as of issue.
  //
  // An issued invoice is a record of a transaction that already happened: if the
  // issuer later moves office or a client is renamed, the invoice that was sent
  // must not silently change. These columns freeze what was on the document.
  //
  // Nullable so invoices created before this migration keep working — readers
  // fall back to the live Company / Client rows for those.
  // --------------------------------------------------------------------------

  /// 発行者 (issuer) as printed on this invoice.
  issuerName               String?
  issuerAddress            String?
  issuerPhone              String?
  issuerEmail              String?
  issuerRegistrationNumber String?

  /// 請求先 (client) as printed on this invoice.
  clientNameSnapshot    String?
  clientAddressSnapshot String?
  clientEmailSnapshot   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Composite foreign key: the referenced client must belong to the same user.
  ///
  /// NoAction rather than Restrict on purpose. Deleting a user cascades to both
  /// clients and invoices in one statement; RESTRICT is checked immediately and
  /// would fail or succeed depending on which cascade PostgreSQL happens to run
  /// first, whereas NO ACTION is checked at the end of the statement, by which
  /// time the invoices are gone too. Deleting a client that still has invoices
  /// is still refused — by this constraint and, with a readable message, by
  /// `deleteClientForUser`.
  client Client @relation(fields: [clientId, userId], references: [id, userId], onDelete: NoAction)

  items InvoiceItem[]

  @@unique([userId, invoiceNumber])
  @@index([userId, issueDate])
  @@index([userId, dueDate])
  /// Matches the composite foreign key, so the referencing-side checks and
  /// "invoices for this client" lookups both use one index.
  @@index([clientId, userId])
  @@map("invoices")
}

/// 請求明細
model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  description String

  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(14, 2)

  /// 適用税率 (percent): 8 or 10. Enforced by validation and a DB check constraint.
  taxRate Int

  /// Tax-exclusive line total in integer yen.
  amount Int

  /// Explicit display order — cuid ids are not sortable.
  position Int @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

/// 課金状態 (billing state). One row per user.
///
/// This table is the ONLY authority on what a user has paid for. It is written
/// exclusively by the Stripe webhook handler after a signature check — never by
/// a browser redirect, never by a client-supplied parameter, never by the
/// /payment/success page.
///
/// It stores Stripe *identifiers* only. No card number, no CVV, no expiry, no
/// cardholder name, no raw payment credential of any kind ever reaches this
/// database: those live with Stripe and are exchanged through Checkout, which
/// the browser talks to directly.
model Billing {
  id     String @id @default(cuid())
  userId String @unique

  /// Stripe Customer id (`cus_…`). Unique so two users cannot share one.
  customerId String? @unique

  /// Stripe Subscription id (`sub_…`) for the recurring plan, when there is one.
  subscriptionId String? @unique

  /// Mirrors the Stripe subscription status, plus `none` before any purchase.
  status BillingStatus @default(none)

  /// The plan this entitlement came from. `lifetime` is the one-time purchase
  /// path, which the architecture supports alongside the monthly subscription.
  plan BillingPlan @default(free)

  /// End of the paid period. Access is granted only while this is in the
  /// future (a `lifetime` purchase leaves it null and never expires).
  currentPeriodEnd DateTime?

  /// Set when the user cancels but has paid through the end of the period.
  cancelAtPeriodEnd Boolean @default(false)

  /// Stripe price id the entitlement was bought at — kept for support and
  /// reporting, never used to decide access.
  priceId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("billing")
}

/// Mirrors Stripe's subscription statuses, with `none` for "never purchased".
enum BillingStatus {
  none
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

enum BillingPlan {
  free
  monthly
  lifetime
}

/// Ledger of Stripe events already applied.
///
/// Stripe guarantees at-least-once delivery: the same event WILL arrive twice
/// eventually. Inserting the event id first, inside the same transaction that
/// applies the change, makes replay a no-op — the unique constraint rejects the
/// second copy and the transaction rolls back without touching billing.
model ProcessedWebhookEvent {
  /// Stripe's own event id (`evt_…`).
  id String @id

  type String

  /// When Stripe created the event, for ordering and debugging.
  eventCreatedAt DateTime

  processedAt DateTime @default(now())

  @@index([type])
  @@index([processedAt])
  @@map("processed_webhook_events")
}

/// Fixed-window rate limit counters.
///
/// Kept in the database rather than in process memory so the limit holds across
/// instances and restarts — an in-memory counter resets on deploy and is per
/// container, which is not a limit at all behind more than one replica.
model RateLimit {
  /// "<bucket>:<subject>:<window start epoch seconds>"
  key String @id

  count Int @default(0)

  /// When this window may be deleted.
  expiresAt DateTime

  @@index([expiresAt])
  @@map("rate_limits")
}
