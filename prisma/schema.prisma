// ============================================================================
//  インボイス作成 (Invoice Sakusei) — データベーススキーマ
//  Money is stored as integer yen (tax-exclusive where noted) so that no
//  floating point rounding can ever reach the database. Per-unit values that
//  legitimately carry fractions (quantity, unit price) use Decimal.
// ============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection string lives in prisma.config.ts (CLI) and in the
  // driver adapter (runtime). It is never inlined into the schema.
}

/// アカウント
model User {
  id String @id @default(cuid())

  email String @unique

  /// Nullable so a magic-link / OAuth identity can exist without a password.
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company?
  clients  Client[]
  invoices Invoice[]

  @@map("users")
}

/// 自社情報 (invoice issuer). One per user.
model Company {
  id     String @id @default(cuid())
  userId String @unique

  name    String
  address String
  phone   String
  email   String

  /// 適格請求書発行事業者登録番号 — "T" + 13 digits.
  registrationNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("companies")
}

/// 取引先 (billing counterparty)
model Client {
  id     String @id @default(cuid())
  userId String

  /// 担当者名 / 宛名 — required.
  name String

  /// 会社名 — optional: a counterparty may be an individual.
  companyName String?
  address     String?
  email       String?
  phone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoices Invoice[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("clients")
}

/// 請求書
model Invoice {
  id       String @id @default(cuid())
  userId   String
  clientId String

  /// Unique per user, e.g. INV-2026-0001.
  invoiceNumber String

  issueDate DateTime @db.Date
  dueDate   DateTime @db.Date

  /// All amounts are integer yen. subtotal is tax-exclusive.
  subtotal Int
  /// 8% 軽減税率分の消費税額
  tax8 Int
  /// 10% 標準税率分の消費税額
  tax10 Int
  /// subtotal + tax8 + tax10
  total Int

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  items InvoiceItem[]

  @@unique([userId, invoiceNumber])
  @@index([userId, issueDate])
  @@index([userId, dueDate])
  @@index([clientId])
  @@map("invoices")
}

/// 請求明細
model InvoiceItem {
  id        String @id @default(cuid())
  invoiceId String

  description String

  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(14, 2)

  /// 適用税率 (percent): 8 or 10. Enforced by validation and a DB check constraint.
  taxRate Int

  /// Tax-exclusive line total in integer yen.
  amount Int

  /// Explicit display order — cuid ids are not sortable.
  position Int @default(0)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}
